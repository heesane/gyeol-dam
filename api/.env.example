# 서버 /data/gyeoldam/.env (git 제외). CONNECTION.md 에 실제값.
DATABASE_URL=postgresql://gyeoldam:<pw>@127.0.0.1:5432/gyeoldam
GYEOLDAM_API_TOKEN=<64hex>
PORT=3110
HOST=127.0.0.1
CODEX_HOME=/home/ubuntu/.codex
# 선택: 에이전트 순서. 기본 codex>claude. 앞에서부터 시도, 실패 시 다음("토큰 남은" 것).
GYEOLDAM_AGENT_ORDER=codex,claude
# 선택: 모델 오버라이드 (미설정 시 코드 고정값 gpt-5.6-sol / claude-opus-5, 둘 다 medium)
# GYEOLDAM_CODEX_MODEL=gpt-5.6-sol
# GYEOLDAM_CLAUDE_MODEL=claude-opus-5
